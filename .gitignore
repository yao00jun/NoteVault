.task
bin
frontend/dist
frontend/node_modules
# Playwright E2E 产物（本地运行生成，不提交）
frontend/playwright-report
frontend/test-results
frontend/e2e/screenshots
build/linux/appimage/build
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
# 发布构建时按 tag 渲染的临时版本信息（generate:syso 用完即删）
build/windows/info.release.json

# Local build artifacts (root)
notevault.exe
# 打包时由 generate:dotdesktop 生成（create:deb/appimage 的前置步骤）
build/linux/*.desktop
*.syso
*.log
coverage.out
.wv2_*
welcome_issue.png

# WorkBuddy local data (private notes/skills, not for public repo)
.workbuddy/

# Wails build cache
.build-cache/

# 中间过程文档与交付物（非源码，不对外提供）
deliverables/
docs/

# E2E 测试基建必须入库：CI 的 E2E job 依赖 playwright.config.ts 与 e2e/*.spec.ts，
# 两者被忽略时 job 只会在 cwd 里按默认规则乱捡文件（曾把 src/**/*.test.ts 当
# Playwright 用例跑，最后报 "No tests found"）。产物仍在上面的 playwright-report /
# test-results / e2e/screenshots 里排除。
frontend/playwright.desktop.config.ts

# 备份文件
*.bak
node_modules/

# 运行时用户数据 / 派生数据（笔记库、向量索引、快照、搜索摘要）——绝不提交
.notevault/

# 操作系统 / 编辑器临时文件
.DS_Store
Thumbs.db
*.tmp

.codegraph
.zcode/
.codegraph/
